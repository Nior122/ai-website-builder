      "Bash(node node_modules/.bin/next dev -p 3000)",
      "Bash(curl -s -o /dev/null -w '%{http_code}' http://localhost:3000/)",
      "Bash(start http://localhost:3000)",
      "Bash(tail -30 /tmp/next-dev.log 2>/dev/null)",
      "Bash(npx next *)",
      "Bash(head -20 /tmp/next-dev.log 2>/dev/null)",
      "Bash(taskkill //F //PID 12592)",
      "Bash(sleep 5 && tail -15 /tmp/next-dev.log 2>/dev/null)",
      "Bash(node -e ' *)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:3000/)"
