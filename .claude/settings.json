      "Bash(curl -s -w '\\\\nHTTP_CODE:%{http_code}' http://localhost:3000/dashboard/generate)",
      "Bash(node -e \"const http = require\\('http'\\); const req = http.get\\('http://localhost:3000/dashboard/generate', {headers: {Cookie: ''}}, res => { console.log\\('STATUS:', res.statusCode\\); res.on\\('data', d => {}\\); }\\); req.on\\('error', e => console.log\\('ERR:', e.message\\)\\);\")",
      "Bash(node -e \"const http = require\\('http'\\); http.get\\('http://localhost:3000/dashboard/projects', {headers: {}}, res => { console.log\\('STATUS:', res.statusCode\\); let d=''; res.on\\('data', c => d+=c\\); res.on\\('end', \\(\\) => console.log\\('FIRST100:', d.substring\\(0,100\\)\\)\\); }\\);\")",
      "Bash(curl -s -o /dev/null -w '%{http_code}\\\\n%{redirect_url}' http://localhost:3000/dashboard)",
      "Bash(curl -s -o /dev/null -w '%{http_code}' http://localhost:3000/dashboard/projects)",
      "Bash(curl -s -o /dev/null -w '%{http_code}' http://localhost:3000/dashboard)",
      "Bash(curl -s -D - -o /dev/null http://localhost:3000/dashboard)",
      "Bash(curl -s http://localhost:3000/dashboard/projects)",
      "Bash(curl -s -D - http://localhost:3000/dashboard/projects)",
      "Bash(curl -s http://localhost:3000/api/projects)",
      "Bash(curl -s http://localhost:3000/api/templates)",
      "Bash(Get-Process -Name node -Error SilentlyContinue)",
      "Bash(Select-Object Id, CPU, WorkingSet64)",
      "Bash(Format-Table)",
      "Bash(tasklist)",
      "Bash(curl -s -o /dev/null -w '%{http_code}' --max-time 5 http://localhost:3000/)",
      "Bash(taskkill /F /PID 26272)",
