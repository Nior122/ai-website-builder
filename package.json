    "marked": "^18.0.6",
    "next": "^15.3.0",
    "openai": "^4.80.0",
    "prismjs": "^1.29.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.54.0",
